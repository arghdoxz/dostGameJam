extends SceneTree
## Rewrites assets/ASSET_MANIFEST.md from the content registry and AssetLibrary.
## A row's status is "final" once the file exists at its path, otherwise "placeholder".
## Run: godot --headless --path . -s res://tools/generate_asset_manifest.gd

const OUT_PATH: String = "res://assets/ASSET_MANIFEST.md"


func _init() -> void:
	var reg: ContentRegistry = load("res://content/content_registry.tres") as ContentRegistry
	var catalog: ContentCatalog = ContentCatalog.from_registry(reg)
	var rows: Array[Dictionary] = AssetLibrary.all_assets(catalog)
	var final_count: int = 0
	for r: Dictionary in rows:
		if String(r["status"]) == "final":
			final_count += 1
	var md: PackedStringArray = PackedStringArray()
	md.append("# Asset Manifest")
	md.append("")
	md.append("Generated by `tools/generate_asset_manifest.gd`. Do not edit by hand: rerun the tool after adding art.")
	md.append("")
	md.append("%d asset slots, %d final, %d placeholder. A missing file never crashes the game: `AssetLibrary` generates a placeholder with the right aspect ratio." % [
		rows.size(), final_count, rows.size() - final_count])
	md.append("")
	md.append("**Hard requirements:** the exact path and file name, PNG format, and the aspect ratio of the listed size. **Recommendations:** the listed pixel size (any size with the same aspect ratio works), sRGB, transparency where marked. See docs/ART_PIPELINE.md.")
	md.append("")
	var current: String = ""
	for r: Dictionary in rows:
		var cat: String = String(r["category"])
		if cat != current:
			current = cat
			md.append("")
			md.append("## %s" % cat)
			md.append("")
			md.append("| Id | Path | Size (aspect) | Alpha | Status | Purpose |")
			md.append("|---|---|---|---|---|---|")
		md.append("| %s | `%s` | %dx%d | %s | %s | %s |" % [
			r["id"], String(r["path"]).trim_prefix("res://"), int(r["w"]), int(r["h"]),
			"yes" if bool(r["alpha"]) else "no", r["status"], r["purpose"]])
	md.append("")
	md.append("## fonts")
	md.append("")
	md.append("| Slot | Path | Format | Status | Purpose |")
	md.append("|---|---|---|---|---|")
	for slot: String in AssetLibrary.FONT_SLOTS:
		var found: bool = AssetLibrary.find_font(slot) != null
		md.append("| %s | `assets/fonts/font_%s.ttf` or `.otf` | TTF or OTF | %s | %s |" % [
			slot, slot, "final" if found else "placeholder (engine default font)",
			"Body text and buttons" if slot == "body" else "Titles and headings"])
	md.append("")
	var f: FileAccess = FileAccess.open(OUT_PATH, FileAccess.WRITE)
	if f == null:
		push_error("Cannot write " + OUT_PATH)
		quit(1)
		return
	f.store_string("\n".join(md))
	f.close()
	print("Manifest written: %d slots (%d final)" % [rows.size(), final_count])
	quit(0)
