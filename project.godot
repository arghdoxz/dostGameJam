; Engine configuration file.
config_version=5

[application]

config/name="Scratch Notes"
config/description="Competitive disaster-preparedness card game (DRRMC theme)."
run/main_scene="res://scenes/boot/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ContentDB="*res://scripts/content_db.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
